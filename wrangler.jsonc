{
  // Cloudflare Worker with static assets.
  //
  // Requests are matched against public/ first; anything with no matching file
  // falls through to src/index.js. That is how /api/inquiry reaches the Worker
  // while every real page and asset is served directly from the edge.
  //
  // This project previously used the Pages "functions/" convention, which is a
  // Pages-only feature — Workers ignored it and served the folder as static
  // files, so the endpoint 404'd. See README for the full story.
  "name": "moments-creative",
  "compatibility_date": "2026-09-05",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  // RESEND_API_KEY lives in the account-level Secrets Store, not as a plain
  // Worker secret, so it has to be bound explicitly here — a Secrets Store
  // secret is NOT visible to a Worker until it is. store_id is an identifier,
  // not a credential; the secret's value never leaves Cloudflare.
  "secrets_store_secrets": [
    {
      "binding": "RESEND_API_KEY",
      "store_id": "d803088bc84e4cb2b4260df4f78e1fa0",
      "secret_name": "RESEND_API_KEY"
    }
  ],

  "observability": {
    "enabled": true
  }
}
